<!-- Plan once, then follow; near goal use Rotation Shim via distance switch -->
<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Sequence>
            <!-- ★ RecoveryNode 直下は “ちょうど2つ” にすること -->
            <RecoveryNode number_of_retries="6" name="NavigateRecovery">
                <!-- (1) 本処理パイプライン -->
                <PipelineSequence name="Navigate_NoReplan">
                <RateController hz="1.0">

                <!-- プランは最初の1回だけ -->
                    <!-- <SingleTrigger name="PlanOnce"> -->
                        <RecoveryNode number_of_retries="1" name="ComputePathToPose">
                            <Sequence>
                                <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                            </Sequence>
                            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                                              service_name="global_costmap/clear_entirely_global_costmap"/>
                        </RecoveryNode>
                    <!-- </SingleTrigger> -->
                  </RateController>

                <!-- 距離で RSC / RPP を切替え、直前に選ばれたIDで FollowPath -->
                    <RecoveryNode number_of_retries="1" name="FollowPathStage">
                        <Sequence>
                            <ReactiveFallback>
                                <!-- 距離 2.5m 以上なら controller_id := RPP -->
                                <DistanceController distance="3.0" global_frame="map" robot_base_frame="mst110cr_2/base_link">
                                  <Sequence>
                                    <Wait wait_duration="1"/>
                                    <SetBlackboard output_key="controller_id" value="RSC"/>
                                  </Sequence>
                                </DistanceController>

                                <!-- それ以外は controller_id := RPP -->
                                <!-- <Wait wait_duration="5"/>
                                <SetBlackboard output_key="controller_id" value="RSC"/> -->

                                <!-- <SetBlackboard output_key="controller_id" value="RSC"/> -->

                            </ReactiveFallback>
                            <!-- 選択したIDで追従 -->
                            <FollowPath path="{path}" controller_id="{controller_id}"/>
                        </Sequence>
                        <ClearEntireCostmap name="ClearLocalCostmap-Context"
                                                    service_name="local_costmap/clear_entirely_local_costmap"/>
                    </RecoveryNode>
                </PipelineSequence>
                <!-- (2) リカバリ枝（最低1つは置く：たとえばクリア＋スピン等） -->
                <ReactiveFallback name="RecoveryFallback">
                  <GoalUpdated/>
                  <RoundRobin name="RecoveryActions">
                    <Sequence name="ClearingActions">
                      <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                          service_name="local_costmap/clear_entirely_local_costmap"/>
                      <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                                          service_name="global_costmap/clear_entirely_global_costmap"/>
                    </Sequence>
                    <Spin spin_dist="1.57"/>
                    <Wait wait_duration="3"/>
                    <BackUp backup_dist="0.30" backup_speed="0.05"/>
                  </RoundRobin>
                </ReactiveFallback>
            </RecoveryNode>
        </Sequence>
    </BehaviorTree>
</root>


